<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Hifz" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:colorPrimary">@color/blue</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
    <style name="Theme.Hifz.Counter">
        <item name="android:windowBackground">@color/counter_bg</item>
        <item name="android:statusBarColor">@color/counter_bg</item>
        <item name="android:navigationBarColor">@color/counter_bg</item>
    </style>
</resources>
